# ── 계좌 활성화 (multi-account) ──────────────────────────────────────────
# 동시에 운용할 계좌 목록(쉼표구분). 기본: mock
#   mock = 모의투자(mockapi.kiwoom.com)
#   real = 실전(api.kiwoom.com)  ⚠️ 실거래
ACCOUNTS=mock,real

# ── mock 계좌 (모의투자) ─────────────────────────────────────────────────
# provider: kiwoom(키움 모의서버) | mock(합성 데이터, 무자격증명)
MOCK_PROVIDER=kiwoom
MOCK_APPKEY=...
MOCK_SECRETKEY=...

# ── real 계좌 (실전) ⚠️ 실제 주문이 나갑니다 ────────────────────────────
# 실전 앱키/시크릿은 모의와 다릅니다(키움 실전 발급분).
# 자격증명이 없으면 이 계좌는 자동으로 건너뜁니다(데모는 mock만으로 동작).
REAL_PROVIDER=kiwoom
REAL_APPKEY=...
REAL_SECRETKEY=...

# 참고: 2열 UI만 먼저 확인하고 싶으면 실 자격증명 없이
#   REAL_PROVIDER=mock
# 으로 두면 '실전' 컬럼이 합성 데이터로 채워져(위험 표시 유지) 레이아웃을 검증할 수 있다.

# ── CORS 허용 출처 ──────────────────────────────────────────────────────
# 브라우저發 교차 출처 요청을 허용할 origin 목록(쉼표구분).
# 기본값은 Vite 개발 서버(5173)뿐이며, 보통 바꿀 필요가 없다 — 프런트는
# 프록시를 거쳐 같은 출처로 호출하므로 교차 출처 요청 자체가 없다.
# 프런트를 다른 포트/호스트에 띄울 때만 지정한다. '*' 는 쓰지 말 것:
# 서버를 켜둔 채 임의의 웹페이지를 방문하면 그 페이지가 실주문을 낼 수 있다.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
